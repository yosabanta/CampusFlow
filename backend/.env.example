# ==============================================================================
# CAMPUSFLOW MVP — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the backend application:
#   cp .env.example .env
# Never commit the actual .env file with secrets into version control.
# ==============================================================================

# Application Environment ('development', 'testing', 'production')
ENVIRONMENT=development
APP_NAME=CampusFLow
APP_VERSION=1.0.0
DEBUG=True

# Database Configuration (Neon Serverless PostgreSQL connection string)
# Format: postgresql+psycopg2://<user>:<password>@<neon-host>/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg2://campusflow_user:campusflow_password@ep-sample-pool-12345.ap-southeast-1.aws.neon.tech/campusflow?sslmode=require

# JWT Authentication
# Secret key for HMAC-SHA256 signature (generate with: openssl rand -hex 32)
JWT_SECRET=super_secret_jwt_key_for_campusflow_hackathon_mvp_2026_change_in_production
JWT_EXPIRY=86400

# File Storage Configuration
# Local directory path where complaint photos, certificates, and materials will be stored
UPLOAD_DIR=uploads

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins for local development
ALLOWED_ORIGINS=https://campusflow-frontend-khaki.vercel.app,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080

# SMS Provider Mode ('mock', 'console', 'live')
# In 'console' / 'mock' mode, outgoing SMS messages are logged without calling an external API.
SMS_PROVIDER_MODE=console
